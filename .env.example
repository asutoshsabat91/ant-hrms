# AntBox HRMS — Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL — pooler connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&pgbouncer=true"

# PostgreSQL — direct connection (used by Prisma migrations only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST-direct/DATABASE?sslmode=require"

# NextAuth
AUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Office location (for GPS attendance check)
OFFICE_LAT="20.352346"
OFFICE_LON="85.816088"
OFFICE_RADIUS_M="200"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=""
